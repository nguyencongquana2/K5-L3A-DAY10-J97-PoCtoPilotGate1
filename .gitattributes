# Preserve exact bytes for files protected by SHA-256 locks or submission manifests.
config/acceptance_criteria.json -text
config/acceptance_criteria.lock -text
lab10/guards_round1.py -text
config/operating_gates.round1.json -text
config/round1.lock -text
submission/submission.json -text
submission/code/** -text
submission/config/** -text
submission/runs/** -text
submission/docs/** -text
submission/manifest.json -text

# Instructor files are hashed as LF bytes in lab10/MANIFEST.json.
# Apply on checkout even when a collaborator has core.autocrlf=true.
.gitattributes text eol=lf
data/** text eol=lf
incidents/** text eol=lf
tests/test_public.py text eol=lf
lab10/__init__.py text eol=lf
lab10/_gradectx.py text eol=lf
lab10/_noop_guards.py text eol=lf
lab10/agent.py text eol=lf
lab10/check_submission.py text eol=lf
lab10/checkpoint.py text eol=lf
lab10/criteria.py text eol=lf
lab10/eval.py text eol=lf
lab10/gate.py text eol=lf
lab10/grade.py text eol=lf
lab10/helpers.py text eol=lf
lab10/mock_llm.py text eol=lf
lab10/ops.py text eol=lf
lab10/tools.py text eol=lf
